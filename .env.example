# ─── Supabase ───────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com and paste the values below.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Spring Boot API ─────────────────────────────────────────────────────────
# Auth, wallet, orders, and PayPal orchestration live here.
VITE_API_URL=http://localhost:8080/api

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Key ID is safe to expose in the browser. Secret stays server-side only.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# Never put RAZORPAY_KEY_SECRET in a VITE_ variable — keep it in Supabase secrets.

# ─── Kiosk ───────────────────────────────────────────────────────────────────
# Unique identifier for this physical kiosk machine.
# Override per-device or pass as ?kiosk_id= query param.
VITE_KIOSK_ID=kiosk_001

# ─── App ─────────────────────────────────────────────────────────────────────
# Operator contact number shown on error / support screens.
VITE_SUPPORT_PHONE=+91-XXXXXXXXXX

# ─── Pricing (defaults, overridden by DB config once Supabase is wired) ──────
VITE_PRICE_BW=3
VITE_PRICE_COLOR=10
VITE_MAX_FILE_MB=20

# ─── Local printer simulator ────────────────────────────────────────────────
# Use normal, offline, paper_out, jam_before_print, or jam_after_40_percent.
# This is development-only; production will use the authenticated bridge API.
VITE_PRINTER_SIM_MODE=normal

